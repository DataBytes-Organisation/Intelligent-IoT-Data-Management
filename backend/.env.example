JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=https://app.example.com

# Databse configuration
DB_USER=replace-me
DB_PASSWORD=replace-me
DB_HOST=replace-me
DB_PORT=replace-me
DB_NAME=replace-me

# Email configuration
MAIL_PROVIDER=approved
MAIL_FROM=no-reply@example.com
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me

# ThingSpeak configuration
THINGSPEAK_CHANNEL_ID=replace-me
THINGSPEAK_RESULTS=replace-me
THINGSPEAK_POLL_INTERVAL_MS=replace-me
THINGSPEAK_MAX_RETRIES=replace-me
THINGSPEAK_RETRY_DELAY_MS=replace-me
THINGSPEAK_DATASET_NAME=thingspeak-live

# Credentials used to provision the ThingSpeak service account. Until the FE
# authentication migration is complete, its owner ID is also the shared identity
# for dataset, series, and timestamp requests.
# TODO(FE auth migration): stop using this shared identity for user requests.
THINGSPEAK_DATASET_OWNER_ID=replace-with-service-account-uuid
THINGSPEAK_DATASET_OWNER_PASSWORD=replace-with-long-random-service-password
